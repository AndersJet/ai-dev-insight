# 首次部署填写；不要提交填写后的 .env，也不要复制根目录的开发 .env。
# 三个密码分别执行 openssl rand -hex 24 生成，使用 48 位十六进制字符串。
# ADI_APP_DB_PASSWORD 会组成 PostgreSQL URI；使用十六进制避免 URL 编码错误。
# 新部署固定项目名；已有部署升级时填原项目名，保留原容器/网络/数据卷身份。
COMPOSE_PROJECT_NAME=ai-dev-insight
ADI_PG_ADMIN_PASSWORD=
ADI_APP_DB_PASSWORD=
ADI_ADMIN_EMAIL=
ADI_ADMIN_PASSWORD=
# 留空允许任意合法邮箱域；用逗号分隔可限制域名，例如 example.org,example.net。
ADI_EMAIL_DOMAINS=
ADI_DATABASE_SCHEMA=adi

# 员工浏览器实际访问的 Origin（不带路径/末尾斜线），及同源 /hooks 地址。
# 示例：HTTP 用 http://服务器IP:4181 与 http://服务器IP:4181/hooks。
# HTTPS 用 https://实际域名 与 https://实际域名/hooks，由现场代理终止 TLS。
ADI_WEB_ORIGIN=
ADI_PUBLIC_COLLECTOR_URL=
# 直接在办公网访问；有本机入口代理时改成 127.0.0.1。
ADI_WEB_BIND_ADDRESS=0.0.0.0
ADI_WEB_HOST_PORT=4181
# Collector仅绑定本机，用于运维readyz检查；员工统一经Web的/hooks上报。
ADI_COLLECTOR_HOST_PORT=4186

# 以下保持默认即可；官方用量开关须单独验收后开启。
ADI_STORAGE_BUDGET_BYTES=
ADI_USAGE_ENABLED=false
ADI_USAGE_STOP_WINDOW_ENABLED=false
ADI_USAGE_PROVIDER_ACCOUNT=
TRAE_OPENAPI_APP_ID=
TRAE_OPENAPI_APP_SECRET=
ADI_ALERT_WEBHOOK_URL=
ADI_ALERT_WEBHOOK_TOKEN=
