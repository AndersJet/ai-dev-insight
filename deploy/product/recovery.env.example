# 仅指向已隔离、未接入入口流量的恢复目标；不复用在线服务的连接变量。
# 先停止目标上的 API/collector/全部 worker，并在网络层保持无入口。
ADI_RECOVERY_DATABASE_URL=
ADI_RECOVERY_DATABASE_SCHEMA=adi
# 操作员已核对目标处于隔离状态；该声明不能代替真实网络隔离。
ADI_RECOVERY_ISOLATED=1
ADI_RECOVERY_OPERATOR_LABEL=
# 最新独立副本，必须保留原数据集 UUID 目录；不能随旧数据库一起回滚。
ADI_CLEANUP_JOURNAL_DIR=

# 导出检查点使用当前源连接，与恢复目标连接分开。
ADI_CLEANUP_CHECKPOINT_SOURCE_DATABASE_URL=
ADI_CLEANUP_CHECKPOINT_SOURCE_DATABASE_SCHEMA=adi
# 停止源清理入口/API和cleanup worker后，由操作员改为1再导出。
ADI_CLEANUP_WRITERS_STOPPED=0
# 成功导出的检查点UUID和SHA256需独立保管，prepare时显式传入。

# 身份快照核验和恢复后登录使用相同的邮箱域策略。
ADI_EMAIL_DOMAINS=
# 身份评审/引导凭据只写入操作员指定的私有目录；不要进入共享日志或代码仓库。
# release仅清除数据库恢复封锁，不自动启动服务或接入流量。
