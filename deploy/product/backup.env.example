# Application-schema logical snapshot only; does not enable a scheduled job.
# Source selection must be explicit and must not be a restored/quarantined DB.
ADI_BACKUP_SOURCE_DATABASE_URL=
ADI_BACKUP_SOURCE_DATABASE_SCHEMA=adi
ADI_BACKUP_SOURCE_CONFIRMED=0
# Pre-created private POSIX directory (0700). Contents may include sensitive data.
ADI_BACKUP_DIRECTORY=
ADI_CLEANUP_JOURNAL_DIR=
ADI_BACKUP_MAX_BYTES=
ADI_BACKUP_MAX_DURATION_MS=
ADI_PG_DUMP_PATH=pg_dump
# Current CLI accepts an ordinary TCP PostgreSQL URL without query overrides.
# Do not treat the bundled checkpoint as the newest cleanup or identity evidence.
