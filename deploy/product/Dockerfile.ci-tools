# Disposable CI tooling only; this is not a product runtime image.
FROM registry-1.docker.io/library/node:24.14.1-bookworm-slim@sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c

ARG ADI_CI_NPM_REGISTRY=https://registry.npmjs.org/
# Tool-image maintenance can use official signed archives when TUNA is blocked.
# Runtime installers keep their existing TUNA default.
ARG ADI_CI_APT_SOURCE=official
LABEL org.opencontainers.image.title="ai-dev-insight CI tools" \
      org.opencontainers.image.description="Pinned Node and pnpm with Git, process, TLS and PostgreSQL 18 tools for disposable CI jobs"

COPY deploy/product/prepare-ci-apt.sh deploy/product/install-ci-test-tools.sh deploy/product/install-ci-postgres-client.sh /tmp/adi-ci-tools/
COPY deploy/product/check-ci-tools.sh /usr/local/bin/adi-ci-check-tools
# BuildKit's disposable RUN container omits Docker Engine's marker. Supply it
# only in this build step; the installers retain their root/Node/CI guards.
RUN touch /.dockerenv \
 && CI=true ADI_CI_APT_SOURCE="$ADI_CI_APT_SOURCE" sh /tmp/adi-ci-tools/install-ci-test-tools.sh \
 && CI=true ADI_CI_APT_SOURCE="$ADI_CI_APT_SOURCE" sh /tmp/adi-ci-tools/install-ci-postgres-client.sh \
 && npm install --global pnpm@10.33.0 --registry="$ADI_CI_NPM_REGISTRY" --no-audit --no-fund \
 && chmod 755 /usr/local/bin/adi-ci-check-tools \
 && sh /usr/local/bin/adi-ci-check-tools \
 && rm -rf /tmp/adi-ci-tools /root/.npm /var/lib/apt/lists/* \
 && rm -f /.dockerenv

CMD ["adi-ci-check-tools"]
