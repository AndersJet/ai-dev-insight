# 运维专用进程读取；不要提交真实值或 source 这个文件。
# preview 只需要 SOURCE_DATABASE_URL / SOURCE_DATABASE_SCHEMA。
ADI_REBUILD_SOURCE_DATABASE_URL=
ADI_REBUILD_SOURCE_DATABASE_SCHEMA=
ADI_REBUILD_TARGET_DATABASE_URL=
ADI_REBUILD_TARGET_DATABASE_SCHEMA=
# 精确重复目标 schema 作为目标确认；必须不同于源 schema。
ADI_REBUILD_TARGET_CONFIRMED_SCHEMA=
# 北京时间00:00的新统计基线；审核后填写 YYYY-MM-DD。
ADI_REBUILD_BASELINE_DATE=
# plan 输出的 artifact 摘要（不是 plan_digest）。
ADI_REBUILD_ARTIFACT_DIGEST=
# 各32字节持久密钥文件，权限0600，挂载为只读，不填密钥内容。
ADI_REBUILD_SOURCE_KEY_FILE=
ADI_REBUILD_TARGET_KEY_FILE=
# 人工核验真实停止写入、网络隔离、备份与独立删除证明后各设1。
ADI_REBUILD_WRITERS_STOPPED=0
ADI_REBUILD_ISOLATION_REVIEWED=0
ADI_REBUILD_BACKUP_JOURNAL_VERIFIED=0
# verify 输出的摘要；完成离线行为/客户端验证并审核后才设完成为1。
ADI_REBUILD_VALIDATION_DIGEST=
ADI_REBUILD_VALIDATION_COMPLETED=0
