# 复制为根目录 .env，填写本地数据库和固定管理员。真实 .env 不提交。
# 邮箱是登录名；固定账号只能从此配置换名或换密，重启后生效。
# URL 中用户名/密码的特殊字符须编码（如 / → %2F、@ → %40、# → %23），不能只加引号。
ADI_DATABASE_URL=postgres://adi_app:replace-with-local-db-password@127.0.0.1:55432/adi
ADI_DATABASE_SCHEMA=adi
# 留空允许任意合法邮箱域；用逗号分隔可限制域名，例如 example.org,example.net。
ADI_EMAIL_DOMAINS=
ADI_ADMIN_EMAIL=admin@example.org
ADI_ADMIN_PASSWORD=

# 本地端口、访问地址和私有清理日志路径均有默认值；按需启用覆盖。
# ADI_API_PORT=4180
# ADI_WEB_PORT=4181
# ADI_COLLECTOR_PORT=4186
# ADI_WEB_ORIGIN=http://127.0.0.1:4181
# ADI_PUBLIC_COLLECTOR_URL=http://127.0.0.1:4186/hooks
# API 凭据加密密钥自动生成，须持久保存并单独备份；勿随重启或发布删除。
# ADI_INSTALLATION_KEY_FILE=/absolute/private/installation-credentials.key
# ADI_CLEANUP_JOURNAL_DIR=/absolute/private/cleanup-journal

# 官方同步未配置时关闭；开启后必须完整配置三项官方凭据。
ADI_USAGE_ENABLED=false
# Stop 秒级发现与 Session 用量查询为受控试用，默认关闭；仅验收后的试用环境启用。
ADI_USAGE_STOP_WINDOW_ENABLED=false
# ADI_USAGE_PROVIDER_ACCOUNT=trae-anc
# TRAE_OPENAPI_APP_ID=
# TRAE_OPENAPI_APP_SECRET=
# ADI_STORAGE_BUDGET_BYTES=填写实测关系文件预算，不能直接填服务器总剩余空间
